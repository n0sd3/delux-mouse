{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delux Mouse",
  "version": "0.1.0",
  "identifier": "local.edson.delux-mouse",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Delux M900 PRO",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
